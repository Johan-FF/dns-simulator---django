    %% Herencia de templates
    BaseTemplate -->|"extends"| PC9
    BaseTemplate -->|"extends"| PA0
    BaseTemplate -->|"extends"| PG1 & PG2 & PG3
    BaseTemplate -->|"extends"| PP1 & PP2 & PP3 & PP4 & PP5
    BaseTemplate -->|"extends"| PE1 & PE2 & PE3 & PE4

    PC9 -->|"extends"| PC1 & PC2 & PC3 & PC4 & PC5 & PC6
    PA0 -->|"extends"| PA1 & PA2 & PA3 & PA4 & PA5 & PA6 & PA7

    %% Archivos estáticos
    BaseTemplate -.->|"incluye"| CSS1
    PE2 -.-> CSS4 & JS1
    PE3 -.-> CSS5 & JS2
    PA0 -.-> CSS3
    PP1 -.-> CSS7 & JS3

    %% Crispy Forms
    CF -.->|"renderiza forms"| PC3 & PP3 & PP4 & PA4

    %% i18n
    I18N -.->|"traducciones"| BaseTemplate
    PG4 -.->|"include"| BaseTemplate

    %% Estilos
    classDef baseStyle fill:#E3F2FD,stroke:#0D47A1,stroke-width:2px
    classDef portalStyle fill:#E8F5E9,stroke:#1B5E20,stroke-width:1px
    classDef pagoStyle fill:#FFF3E0,stroke:#E65100,stroke-width:1px
    classDef staticStyle fill:#F3E5F5,stroke:#4A148C,stroke-width:1px
    classDef crispyStyle fill:#FFF9C4,stroke:#F57F17,stroke-width:1px

    class BaseTemplate baseStyle
    class PC1,PC2,PC3,PC4,PC5,PC6,PC7,PC8,PC9 portalStyle
    class PE1,PE2,PE3,PE4 portalStyle
    class PA0,PA1,PA2,PA3,PA4,PA5,PA6,PA7,PA8 portalStyle
    class PD1,PD2 portalStyle
    class PP1,PP2,PP3,PP4,PP5,PP6,PP7,PP8,PP9 pagoStyle
    class CSS1,CSS2,CSS3,CSS4,CSS5,CSS6,CSS7,CSS8,JS1,JS2,JS3 staticStyle
    class CF crispyStyle
